# Copy this file to `keystore.properties` (it is git-ignored) and fill it in to build a SIGNED release.
# Copie para `keystore.properties` (ignorado pelo git) e preencha para gerar um release ASSINADO.
#
# Create a key once / crie a chave uma vez:
#   keytool -genkeypair -keystore codedroid-release.jks -alias codedroid \
#           -keyalg RSA -keysize 4096 -validity 10000
#
# Keep the .jks and its passwords somewhere safe and OUTSIDE this repository: if you lose them you
# can no longer publish updates that install over existing installs.
# Guarde o .jks e as senhas FORA deste repositorio: sem elas nao ha como lancar atualizacoes.
#
# Windows: escape backslashes and the colon, e.g. C\:\\keys\\codedroid-release.jks
storeFile=/absolute/path/to/codedroid-release.jks
storePassword=CHANGE_ME
keyAlias=codedroid
keyPassword=CHANGE_ME
